---
export interface Props {
  siteName: string;
  disclaimer: string;
}

const { siteName, disclaimer } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container stack">
    <p class="muted site-footer__disclaimer">{disclaimer}</p>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/disclaimer">Disclaimer</a></li>
        <li><a href="/official-resources">Official Resources</a></li>
      </ul>
    </nav>
    <p class="muted site-footer__copy">&copy; {year} {siteName}. Not affiliated with any government body.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    padding-block: 2rem;
    font-size: 0.9rem;
  }
  .site-footer__links {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-footer__copy {
    font-size: 0.8rem;
  }
</style>
