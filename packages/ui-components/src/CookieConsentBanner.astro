---
// Custom, lightweight cookie consent banner (Section 10 / open question:
// build custom vs. third-party script — this repo defaults to custom to
// avoid a third-party render-blocking dependency; swap for a CMP if a
// specific market's compliance needs outgrow this).
---

<div class="cookie-banner" data-cookie-banner hidden>
  <div class="container cookie-banner__inner">
    <p>
      This site uses cookies, including from Google AdSense, to serve ads. See our
      <a href="/privacy-policy">Privacy Policy</a> for details.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="btn btn-secondary" data-cookie-reject>Reject non-essential</button>
      <button type="button" class="btn" data-cookie-accept>Accept</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    background: var(--color-text);
    color: #fff;
    z-index: 200;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.15);
  }
  .cookie-banner a {
    color: #fff;
    text-decoration: underline;
  }
  .cookie-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1rem;
    font-size: 0.9rem;
  }
  .cookie-banner__actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
</style>

<script>
  const STORAGE_KEY = "cookie-consent";
  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");

  function setConsent(value: "accepted" | "rejected") {
    localStorage.setItem(STORAGE_KEY, value);
    document.dispatchEvent(new CustomEvent("cookie-consent-changed", { detail: { value } }));
    if (banner) banner.hidden = true;
  }

  if (banner) {
    const existing = localStorage.getItem(STORAGE_KEY);
    if (!existing) {
      banner.hidden = false;
    } else {
      document.dispatchEvent(new CustomEvent("cookie-consent-changed", { detail: { value: existing } }));
    }

    banner.querySelector("[data-cookie-accept]")?.addEventListener("click", () => setConsent("accepted"));
    banner.querySelector("[data-cookie-reject]")?.addEventListener("click", () => setConsent("rejected"));
  }
</script>
