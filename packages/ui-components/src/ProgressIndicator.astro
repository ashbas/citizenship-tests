---
export interface Props {
  total: number;
  current?: number;
}

const { total, current = 1 } = Astro.props;
---

<div class="progress" data-progress data-total={total}>
  <div class="progress__bar">
    <div class="progress__fill" data-progress-fill style={`width: ${(current / total) * 100}%`}></div>
  </div>
  <p class="muted progress__label" data-progress-label>Question {current} of {total}</p>
</div>

<style>
  .progress__bar {
    height: 8px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }
  .progress__fill {
    height: 100%;
    background: var(--color-primary);
    transition: width 0.2s ease;
  }
  .progress__label {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
  }
</style>
