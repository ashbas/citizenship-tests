---
import type { OfficialSource } from "@citizenship-tests/quiz-engine";

export interface Props {
  officialSource: OfficialSource;
}

const { officialSource } = Astro.props;
---

<aside class="official-callout card">
  <p class="official-callout__eyebrow muted">Official source</p>
  <p class="official-callout__body">
    This practice content is inspired by <strong>{officialSource.name}</strong>
    {officialSource.handbookName && <> and <em>{officialSource.handbookName}</em></>}.
    Always verify against the official material before your test.
  </p>
  <a class="btn btn-secondary" href={officialSource.url} rel="noopener noreferrer" target="_blank">
    Visit official source →
  </a>
</aside>

<style>
  .official-callout {
    border-left: 4px solid var(--color-primary);
  }
  .official-callout__eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    margin: 0 0 0.4rem;
  }
  .official-callout__body {
    margin: 0 0 0.9rem;
  }
</style>
