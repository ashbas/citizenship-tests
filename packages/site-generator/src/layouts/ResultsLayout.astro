---
import BaseLayout from "./BaseLayout.astro";
import ResultsSummary from "@citizenship-tests/ui-components/ResultsSummary.astro";
import AdSlot from "@citizenship-tests/ui-components/AdSlot.astro";
import { buildMeta } from "@citizenship-tests/seo-utils";
import type { SiteData } from "../data/index.js";

export interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const { config, questions, categories } = data;

const meta = buildMeta({
  siteName: config.siteName,
  domain: config.domain,
  path: "/results",
  pageTitle: "Your Mock Exam Results",
  description: `Review your ${config.siteName} mock exam score, a full answer breakdown, and links back to the topics you should study more.`,
});

const clientPayload = {
  questions,
  categories,
  testFormat: config.testFormat,
  scoringRules: config.scoringRules,
};
---

<BaseLayout siteName={config.siteName} disclaimer={config.disclaimer} meta={meta} currentPath="/results">
  <h1>Your Results</h1>

  <ResultsSummary />
  <AdSlot slot="results" />

  <section data-results-weak-categories hidden>
    <h2>Topics to review</h2>
    <ul data-results-weak-list></ul>
  </section>

  <section>
    <h2>Full Answer Review</h2>
    <ol class="stack results-review-list" data-results-review></ol>
  </section>

  <p><a href="/mock-exam" class="btn btn-secondary">Take another mock exam</a></p>

  <script type="application/json" id="results-data" set:html={JSON.stringify(clientPayload)} />
</BaseLayout>

<style>
  .results-review-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
</style>

<script>
  import { initResults } from "../client/results.js";
  initResults();
</script>
